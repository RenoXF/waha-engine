[Unit]
Description=WAHA Engine API + Web UI
After=network-online.target waha.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
# Bun otomatis memuat __ROOT__/.env.
ExecStart=__BUN__ run src/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
