# ===== Server =====
PORT=4000
HOST=0.0.0.0

# ===== Database =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waha_engine

# ===== JWT =====
JWT_SECRET=change-me-to-random-string
JWT_EXPIRY=7d

# ===== WAHA =====
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=change-me
WAHA_SESSION_NAME=default

# ===== Webhook =====
WEBHOOK_HMAC_KEY=change-me-to-random-secret

# ===== Admin (auto-seed) =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ===== WAHA .env (in waha/ folder) =====
# WHATSAPP_DEFAULT_ENGINE=NOWEB
# WAHA_API_KEY=<same as above>
# WAHA_DASHBOARD_USERNAME=admin
# WAHA_DASHBOARD_PASSWORD=admin123
# WAHA_MEDIA_STORAGE=LOCAL
# WHATSAPP_FILES_FOLDER=./.media
# WHATSAPP_SESSIONS_POSTGRESQL_URL=<same as DATABASE_URL>
# WHATSAPP_WEBHOOK_URL=http://localhost:4000/webhook
# WHATSAPP_WEBHOOK_HMAC_KEY=<same as WEBHOOK_HMAC_KEY>
# WAHA_NOWEB_STORE_ENABLED=true
