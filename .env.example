# Salin ke .env: cp .env.example .env
# JANGAN commit .env (sudah di .gitignore).

# ===== Server =====
PORT=4000
HOST=0.0.0.0

# ===== Login (satu password bersama) =====
APP_PASSWORD=ganti-password-ini

# ===== Database =====
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/waha_engine

# ===== WAHA engine: src/engine/waha/.env =====
# Engine dan WAHA satu VM. Tidak ada API key, dashboard password, atau HMAC:
#   WAHA_NO_API_KEY=true
#   WAHA_DASHBOARD_NO_PASSWORD=true
#   WHATSAPP_SWAGGER_NO_PASSWORD=true
#   WHATSAPP_DEFAULT_ENGINE=NOWEB
#   WHATSAPP_HOOK_URL=http://localhost:4000/webhook
#   WHATSAPP_HOOK_EVENTS=*
#   WHATSAPP_FILES_FOLDER=.media
#
# WAHA construct AuthConfig saat import, SEBELUM NestJS ConfigModule muat .env.
# Jadi WAHA wajib dijalankan dengan --env-file (sudah di-handle start.sh).
