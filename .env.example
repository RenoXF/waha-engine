# Salin ke .env: cp .env.example .env
# JANGAN commit .env (sudah di .gitignore).

# ===== Server =====
PORT=4000
HOST=0.0.0.0
# WAJIB 'production' di server. Mengontrol apakah token boleh lewat query string
# (?token=) — di production dimatikan supaya token tidak masuk access log proxy
# dan browser history. Di dev tetap boleh karena Vite (5173) cross-origin ke
# API (4000) dan EventSource tidak bisa set header.
NODE_ENV=production
# Production: API menyajikan SPA dari port yang sama, jadi same-origin dan CORS
# tidak dipakai. Yang perlu ada hanya origin `bunx vite` untuk dev.
# Kalau nanti web di-host terpisah, tambahkan domainnya di sini (pisahkan koma).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Database =====
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/waha_engine

# ===== JWT =====
# openssl rand -hex 32
JWT_SECRET=ganti-dengan-random-string
JWT_EXPIRY=7d

# ===== WAHA =====
WAHA_BASE_URL=http://localhost:3000
# Harus SAMA dengan WAHA_API_KEY di src/engine/waha/.env
WAHA_API_KEY=ganti-dengan-api-key-waha
WAHA_SESSION_NAME=default

# ===== Webhook =====
# openssl rand -hex 32
WEBHOOK_HMAC_KEY=ganti-dengan-hmac-key

# ===== Admin (auto-seed, hanya untuk lokal) =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123


# ===== WAHA engine: src/engine/waha/.env =====
# WAHA construct AuthConfig saat import, SEBELUM NestJS ConfigModule muat .env.
# Jadi file ini wajib, dan WAHA harus dijalankan dengan:
#   node --env-file=.env dist/main
# pm2 sudah handle ini lewat node_args di ecosystem.config.cjs.
# Kalau dijalankan polos `node dist/main`, semua endpoint balas 401.

# WAHA_API_KEY=<sama dengan WAHA_API_KEY di root .env>
# WAHA_DASHBOARD_USERNAME=admin
# WAHA_DASHBOARD_PASSWORD=admin123

# NOWEB = tanpa Chrome, Recommended kalau WEBJS gagal start.
# WEBJS butuh Chrome terinstall di /usr/bin/google-chrome, kalau tidak:
# "Browser was not found at the configured executablePath"
# WAHA_SESSION_CONFIG — config yang dipasang setiap kali session dibuat.
# NOWEB tanpa store aktif akan membalas 400 di semua endpoint chat.
# WAHA_SESSION_CONFIG={"noweb":{"store":{"enabled":true,"fullSync":true}}}

# WHATSAPP_DEFAULT_ENGINE=NOWEB

# WAHA_MEDIA_STORAGE=LOCAL
# src/server/files.ts membaca ../../engine/waha/.media, jadi path relatif ini wajib
# WHATSAPP_FILES_FOLDER=.media

# WAHA_NOWEB_STORE_ENABLED=true
