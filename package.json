{
  "name": "waha-engine",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "start:all": "bash start.sh start",
    "stop": "bash start.sh stop",
    "logs": "bash start.sh logs",
    "test": "bun test src/waha src/server src/web/src/stores",
    "db:migrate": "bun -e \"import('./src/db/migrate').then(m => m.migrate())\"",
    "lint": "bunx prettier --check .",
    "format": "bunx prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9"
  }
}
