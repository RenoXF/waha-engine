{
  "name": "waha-engine",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "start": "bun run index.ts",
    "test": "bun test",
    "db:migrate": "bun run -e \"import('./src/db/migrate').then(m => m.migrate())\"",
    "db:seed": "bun run -e \"import('./src/db/seed').then(s => s.seed())\"",
    "lint": "bunx prettier --check .",
    "format": "bunx prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "croner": "^10.0.1",
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9"
  }
}
